# docker-compose 용 환경변수 템플릿
#
# NOTE: 이 파일에는 실제 값을 절대 넣지 않는다
#       실제 값은 .env 에만 두며 .env 는 gitignore 대상이다
#
# 사용법
#   cp .env.example .env
#   그 후 아래 생성 명령으로 만든 값을 .env 에 채워 넣는다

# MARK: MySQL
MYSQL_ROOT_PASSWORD=<generate: openssl rand -base64 24>
MYSQL_DATABASE=greentech_hr
MYSQL_USER=greentech
MYSQL_PASSWORD=<generate: openssl rand -base64 24>
MYSQL_PORT=3306

# MARK: 애플리케이션
APP_PORT=8080

# MARK: 보안
# JWT 서명키 - HS256 기준 32바이트 이상
#   생성: openssl rand -base64 48
JWT_SECRET=<generate: openssl rand -base64 48>

# 민감 컬럼 암호화 키 - Base64 인코딩된 32바이트 AES 키
#   생성: openssl rand -base64 32
# NOTE: 이 키를 교체하면 기존 주민등록번호를 복호화할 수 없다
#       교체 시 재암호화 마이그레이션이 선행되어야 한다
FIELD_ENCRYPTION_KEY=<generate: openssl rand -base64 32>

# 데모용 계정(hr01/mgr01/emp01) 비밀번호
#   생성: openssl rand -base64 18
BOOTSTRAP_PASSWORD=<generate: openssl rand -base64 18>

# MARK: 관리자 계정
# NOTE: 기동할 때마다 없으면 생성된다 - 볼륨을 삭제해도 이 값으로 복구된다
#       계정이 이미 있으면 건드리지 않으므로 운영 중 변경한 비밀번호는 덮어쓰지 않는다
# FIXME: 운영 환경에서는 추측 가능한 값을 쓰지 말고 최초 로그인 후 즉시 변경할 것
ADMIN_USERNAME=greentech_admin
ADMIN_PASSWORD=<set: 운영은 openssl rand -base64 18 권장>
