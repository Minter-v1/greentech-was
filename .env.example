# MARK: MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=

# MARK: 애플리케이션
APP_PORT=

# MARK: 보안
JWT_SECRET=

FIELD_ENCRYPTION_KEY=

# MARK: 초기 관리자 계정
ADMIN_USERNAME=
ADMIN_PASSWORD=

# true 로 두면 기동할 때마다 ADMIN_PASSWORD 로 비밀번호를 되돌린다
ADMIN_RESET_PASSWORD=false

# MARK: 파일 저장소
# local: 온프레미스 파일 시스템, prod: NCP Object Storage
SPRING_PROFILES_ACTIVE=local
FILE_STORAGE_ROOT=./uploads

# NCP Object Storage 사용 시 입력
NCP_STORAGE_ENDPOINT=https://kr.object.private.ncloudstorage.com
NCP_STORAGE_REGION=kr-standard
NCP_STORAGE_BUCKET=
NCP_STORAGE_ACCESS_KEY=
NCP_STORAGE_SECRET_KEY=
